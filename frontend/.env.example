# GenLayer RPC API URL - Waypoint is deployed on Bradbury testnet
NEXT_PUBLIC_GENLAYER_RPC_URL=https://rpc-bradbury.genlayer.com

# GenLayer Network Configuration - must stay consistent with the RPC URL
# above (chain ID 4221 = Bradbury). Mixing a Bradbury chain ID with a
# different network's RPC URL will make wallet connections and contract
# calls target inconsistent endpoints.
NEXT_PUBLIC_GENLAYER_CHAIN_ID=4221
NEXT_PUBLIC_GENLAYER_CHAIN_NAME=GenLayer Bradbury Testnet
NEXT_PUBLIC_GENLAYER_SYMBOL=GEN

# GenLayer Waypoint Contract Address
# This is the address of your deployed Waypoint contract on GenLayer
NEXT_PUBLIC_CONTRACT_ADDRESS=your_contract_address
